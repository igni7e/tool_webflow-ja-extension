{
  "manifest_version": 3,
  "name": "Webflow 日本語化",
  "description": "Webflowを日本語で使えるようにするChrome拡張機能。ダッシュボードとデザイナーのUIを日本語に翻訳します。",
  "version": "1.2.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webflow 日本語化",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://webflow.com/*",
    "https://*.webflow.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://webflow.com/*",
        "https://*.webflow.com/*"
      ],
      "js": [
        "src/constants.js",
        "src/csv.js",
        "src/translator.js",
        "src/dom.js",
        "src/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["translation_terms.csv"],
      "matches": ["https://webflow.com/*", "https://*.webflow.com/*"]
    }
  ],
  "options_page": "options.html"
}
